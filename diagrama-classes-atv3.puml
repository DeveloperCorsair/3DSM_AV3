@startuml cinebridge-atv3
title CineBridge - ATVIII: Adapter, Composite e Decorator
skinparam classAttributeIconSize 0

package "Servico (alvo dos adaptadores)" {
  class ServicoRecomendacaoEquipe {
    -adaptadores: Adaptadores
    +gerarRecomendacao(entrada): SaidaGerarRecomendacao
    +pagarEquipe(recomendacao, contaOrigem): ComprovantePagamento[]
    +definirEstrategia(estrategia)
    +configurarAdaptadores(adaptadores)
  }
}

package "Adapter" {
  interface AdaptadorArmazenamento {
    +salvarArquivo(conteudo, metadados): Promise<string>
    +recuperarArquivo(id): Promise<Buffer>
    +listarArquivos(prefixo): Promise<string[]>
  }
  interface AdaptadorPagamento {
    +efetuarPagamento(valor, origem, destino): Promise<string>
    +cancelarPagamento(id): Promise<boolean>
    +verificarPagamento(id): Promise<StatusPagamento>
  }
  interface AdaptadorProfissional {
    +listarProfissionais(criterios): Promise<Profissional[]>
    +detalharProfissional(id): Promise<Profissional>
    +registrarAvaliacao(id, avaliacao): Promise<void>
  }
  class AdaptadorS3
  class AdaptadorGoogleCloud
  class AdaptadorLocal
  class AdaptadorStripe
  class AdaptadorPagSeguro
  class AdaptadorPayPal
  class AdaptadorLinkedIn
  class AdaptadorIndeed
  class AdaptadorInterno
  class ClienteS3Simulado
  class ClienteGoogleCloudSimulado
  class ClienteStripeSimulado
  class ClientePagSeguroSimulado
  class ClientePayPalSimulado
  class ApiLinkedInSimulada
  class ApiIndeedSimulada
  class RepositorioProfissionais <<interface>>
}

ServicoRecomendacaoEquipe --> AdaptadorArmazenamento : utiliza
ServicoRecomendacaoEquipe --> AdaptadorPagamento : utiliza
ServicoRecomendacaoEquipe --> AdaptadorProfissional : utiliza
AdaptadorArmazenamento <|.. AdaptadorS3
AdaptadorArmazenamento <|.. AdaptadorGoogleCloud
AdaptadorArmazenamento <|.. AdaptadorLocal
AdaptadorPagamento <|.. AdaptadorStripe
AdaptadorPagamento <|.. AdaptadorPagSeguro
AdaptadorPagamento <|.. AdaptadorPayPal
AdaptadorProfissional <|.. AdaptadorLinkedIn
AdaptadorProfissional <|.. AdaptadorIndeed
AdaptadorProfissional <|.. AdaptadorInterno
AdaptadorS3 --> ClienteS3Simulado : adapta
AdaptadorGoogleCloud --> ClienteGoogleCloudSimulado : adapta
AdaptadorStripe --> ClienteStripeSimulado : adapta
AdaptadorPagSeguro --> ClientePagSeguroSimulado : adapta
AdaptadorPayPal --> ClientePayPalSimulado : adapta
AdaptadorLinkedIn --> ApiLinkedInSimulada : adapta
AdaptadorIndeed --> ApiIndeedSimulada : adapta
AdaptadorInterno --> RepositorioProfissionais : adapta

package "Composite" {
  interface ServicoProjeto {
    +nome: string
    +calcularCusto(): number
    +listarSubservicos(): ServicoProjeto[]
    +obterPrazo(): number
    +validar(): ResultadoValidacaoServico
  }
  class ServicoAtomico {
    +papel: NomePapel
    +peso: number
  }
  class PacoteServico {
    +execucao: "sequencial"|"paralela"
    +prazoMaximoDias?: number
    +adicionar(filho): this
  }
  class Projeto {
    +servicoPrincipal?: ServicoProjeto
    +calcularCustoTotal(): number
    +obterPrazoTotal(): number
    +validarEstrutura(): ResultadoValidacaoServico
  }
}
ServicoProjeto <|.. ServicoAtomico
ServicoProjeto <|.. PacoteServico
PacoteServico o-- "0..*" ServicoProjeto : filhos
Projeto --> "0..1" ServicoProjeto : servicoPrincipal

package "Decorator" {
  interface EstrategiaRecomendacao {
    +nome: string
    +recomendar(projeto, papel, candidatos): ItemRecomendacao[]
  }
  class RecomendadorBase
  abstract class DecoradorRecomendacao {
    #interno: EstrategiaRecomendacao
  }
  class CacheDecorator
  class AuditoriaDecorator
  class CompressaoDecorator
  class FabricaPilhaRecomendacao {
    +montar(base, politica): EstrategiaRecomendacao
  }
}
EstrategiaRecomendacao <|.. RecomendadorBase
EstrategiaRecomendacao <|.. DecoradorRecomendacao
DecoradorRecomendacao <|-- CacheDecorator
DecoradorRecomendacao <|-- AuditoriaDecorator
DecoradorRecomendacao <|-- CompressaoDecorator
DecoradorRecomendacao o-- EstrategiaRecomendacao : interno
FabricaPilhaRecomendacao ..> DecoradorRecomendacao : cria
ServicoRecomendacaoEquipe --> EstrategiaRecomendacao : utiliza
@enduml
